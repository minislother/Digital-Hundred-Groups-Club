{
  "name": "baituan-frontend-monorepo",
  "private": true,
  "workspaces": [
    "frontend-shared",
    "web_portal",
    "vue_student",
    "vue_admin",
    "vue_superadmin"
  ],
  "scripts": {
    "dev:portal": "npm --prefix web_portal run dev",
    "build:portal": "npm --prefix web_portal run build:prod",
    "dev:student": "npm --prefix vue_student run dev -- --port 9533",
    "dev:admin": "npm --prefix vue_admin run dev -- --port 9531",
    "dev:superadmin": "npm --prefix vue_superadmin run dev -- --port 9532",
    "build:student": "npm --prefix vue_student run build:prod",
    "build:admin": "npm --prefix vue_admin run build:prod",
    "build:superadmin": "npm --prefix vue_superadmin run build:prod",
    "build:frontends": "npm run build:portal && npm run build:student && npm run build:admin && npm run build:superadmin"
  },
  "packageManager": "pnpm@11.25.0"
}
