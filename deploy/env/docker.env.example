# Copy this file to .env in the project root or export these values before running docker compose.
# Do not commit real production passwords or JWT secrets.

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=club
MYSQL_USER=baituan_user
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_MAX_CONNECTIONS=200

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_MAXMEMORY=384mb

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_SECONDS=604800

SERVER_PORT=8081
UPLOAD_DIR=/var/baituan/upload/
LOG_PATH=/var/log/baituan
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=5
REDIS_POOL_MAX_ACTIVE=200
BUSINESS_CACHE_ENABLED=true
REQUEST_LOG_ENABLED=false

KAFKA_ENABLED=false
KAFKA_LISTENER_AUTO_STARTUP=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NUM_PARTITIONS=6

FRONTEND_STUDENT_URL=http://localhost:9533/#/login
FRONTEND_ADMIN_URL=http://localhost:9531/#/login
FRONTEND_SUPERADMIN_URL=http://localhost:9532/#/login
CORS_ALLOWED_ORIGINS=http://localhost:9527,http://localhost:9533,http://localhost:9531,http://localhost:9532

# Bind frontend ports to loopback when a host-level HTTPS reverse proxy is used.
PUBLIC_BIND_ADDRESS=127.0.0.1

# Container resource ceilings. Tune these after observing production metrics.
MYSQL_MEMORY_LIMIT=2g
MYSQL_CPU_LIMIT=1.5
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=1.0
KAFKA_MEMORY_LIMIT=1g
KAFKA_CPU_LIMIT=1.5
