SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
FORWARD_HEADERS_STRATEGY=framework

DB_URL=jdbc:mysql://127.0.0.1:3306/club?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=baituan_user
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRE_SECONDS=604800
CORS_ALLOWED_ORIGINS=https://student.example.com,https://admin.example.com,https://superadmin.example.com

UPLOAD_DIR=/var/baituan/upload/
LOG_PATH=/var/log/baituan

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_LISTENER_AUTO_STARTUP=false
KAFKA_LISTENER_CONCURRENCY=1
